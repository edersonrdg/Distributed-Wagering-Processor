{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun run dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:integration": "bun test test/integration --timeout=120000",
    "test:concurrency": "bun test test/concurrency --timeout=120000 --isolate",
    "test:all": "bun test src test/integration test/concurrency --timeout=120000",
    "test:load": "k6 run test/load/load-test.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "orm": "bun node_modules/.bin/mikro-orm",
    "migration:create": "bun run orm migration:create",
    "migration:up": "bun run orm migration:up",
    "migration:down": "bun run orm migration:down",
    "migration:pending": "bun run orm migration:pending",
    "migration:list": "bun run orm migration:list"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1124.0",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.14",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "big.js": "^7.0.1",
    "k6": "^0.0.0",
    "nestjs-cls": "^6.2.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^7.1.14",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/localstack": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/big.js": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/k6": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "bun-types": "^1.4.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./src/shared/database/mikro-orm-cli.config.ts"
    ]
  }
}
